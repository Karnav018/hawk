rules_version = '2';

// Multi-tenant isolation, enforced by the database rather than by every query.
//
// This is the piece that replaces `WHERE user_id = :caller` in the SQL
// backend. There, forgetting the clause leaked another user's rows; here,
// forgetting it gets the read denied. That is a strictly better failure mode,
// and it is the main thing Firestore buys us on this axis.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Fields the client must never write, whatever it claims.
    function ownerUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // Profile only. Quota and plan are server-owned: a client that could
      // write its own tier would grant itself Premium. `storageSetupAt` is
      // absent from the list on purpose — it ends onboarding, and
      // `complete_storage_setup` is what decides that.
      //
      // `inputPreference` is pinned to the two values the app knows how to
      // route on. It picks the home screen — orb or chat — and a third value
      // written by a stale or tampered client is a user with no home screen,
      // resolved here rather than by every reader guessing a default.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'inputPreference', 'onboardedAt', 'updatedAt'])
        && (!('inputPreference' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.inputPreference in ['voice', 'typing']);

      // The same allowlist as `update`, for the same reason.
      //
      // Screen 3J's write is a `set(merge: true)` against a document the
      // blocking trigger may never have created — so on a project without
      // Identity Platform it arrives here as a *create*, and an unrestricted
      // create is an unrestricted update with one extra step. `filedBytes`
      // is the one that bites: it is the server-owned file-storage meter,
      // read straight off this document, and a client that could seed it
      // negative would have granted itself unlimited storage.
      allow create: if isOwner(userId)
        && request.resource.data.keys()
             .hasOnly(['name', 'inputPreference', 'onboardedAt', 'updatedAt'])
        && (!('inputPreference' in request.resource.data.keys())
            || request.resource.data.inputPreference in ['voice', 'typing']);
      allow delete: if false;

      // Entitlements are written by Cloud Functions with the Admin SDK, which
      // bypasses these rules entirely.
      match /subscription/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Screen 2J. Written only by billing_api from the stores' own
      // authenticated responses. A receipt the user could author — or edit —
      // would be worth nothing as a record of what was charged.
      match /receipts/{receiptId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /usage/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /memories/{memoryId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId)
        // Status and recall state belong to the pipeline. A client that could
        // set `ready` would make an un-embedded memory answerable.
        && request.resource.data.status == 'uploaded'
        && request.resource.data.recallState == 'active';
      allow update: if isOwner(resource.data.userId) && ownerUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'updatedAt', 'lastAccessedAt', 'accessCount']);
      allow delete: if isOwner(resource.data.userId);
    }

    // Chunks carry the embeddings. Read-only to the client — they are written
    // by the pipeline, and a writable vector is a poisoned index.
    match /chunks/{chunkId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    match /topics/{topicId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    match /entities/{entityId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    match /sources/{sourceId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);

      match /messages/{messageId} {
        allow read: if isOwner(get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId);
        // Answers and their citations come from the RAG function, not the
        // client — otherwise anyone could fabricate a cited answer.
        allow write: if false;
      }
    }

    // The account row itself carries nothing secret — provider, which account,
    // state, folder selection — so the app can render screen 3F straight from
    // a snapshot listener.
    match /storageAccounts/{accountId} {
      allow read: if isOwner(resource.data.userId);
      // Connecting, re-scoping and disconnecting all go through callables,
      // which is what makes the free tier's one-account limit enforceable.
      allow write: if false;

      // The OAuth grant. Denied to *everyone*, including the owner: a
      // refresh token is a permanent key to the user's entire drive, and
      // there is no screen that needs to read one.
      //
      // This is a subcollection rather than fields on the account precisely
      // because `allow read` above cannot redact — a rule grants the whole
      // document or none of it, so anything sitting next to `provider` is
      // readable by any client holding the owner's ID token.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    // PKCE verifiers. Server-only for the same reason as `emailChallenges`:
    // the verifier is one half of the pair that turns an intercepted redirect
    // into somebody else's storage.
    match /oauthChallenges/{challengeId} {
      allow read, write: if false;
    }

    // Screen 3L streams this document. Readable so the progress bar needs no
    // polling endpoint; written only by the index worker.
    match /indexJobs/{jobId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    // Maps a store's subscription identity to a user, so a renewal or a
    // cancellation notification — which arrives with no Firebase uid — knows
    // where to land. Server-only in both directions: readable, it would say
    // which receipts exist; writable, it would let a client claim someone
    // else's subscription.
    match /storeSubscriptions/{transactionId} {
      allow read, write: if false;
    }

    match /backupSnapshots/{snapshotId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    // Sign-in codes. Entirely server-side: a readable challenge collection
    // would hand out every code in the system.
    match /emailChallenges/{challengeId} {
      allow read, write: if false;
    }

    // Test accounts: one document per account, its ID the email address or
    // the uid, added and removed in the Firebase console. Read only by Cloud
    // Functions through the Admin SDK. Readable, it would say which accounts
    // are privileged; writable, it would let a client grant itself Premium.
    match /testAccounts/{accountId} {
      allow read, write: if false;
    }

    // Offers and news by email (marketing.py). Campaigns are written in the
    // Firebase console and sent by Cloud Functions; opt-outs and the daily
    // send counter are server records. None of it is the app's to read or
    // write. A user's own consent lives on their profile, and only the
    // `set_marketing_consent` callable changes it.
    match /campaigns/{document=**} {
      allow read, write: if false;
    }
    match /marketingOptOuts/{email} {
      allow read, write: if false;
    }
    match /mailStats/{day} {
      allow read, write: if false;
    }

    // Razorpay orders (razorpay_payments.py): who each order belongs to and
    // whether it was paid. Server-only. Writable, an order could be marked
    // paid or reassigned to another user; the plan itself is granted only by
    // `verify_razorpay_payment`.
    match /razorpayOrders/{orderId} {
      allow read, write: if false;
    }

    // Anything not named above is denied. New collections are locked by
    // default rather than open by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

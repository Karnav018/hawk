{
  "indexes": [
    {
      "_comment": "Library list: a user's memories, newest first. Firestore needs a composite index for any query that filters on one field and orders by another.",
      "collectionGroup": "memories",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Library filtered by type.",
      "collectionGroup": "memories",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "type",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Retrieval only ever looks at active memories.",
      "collectionGroup": "memories",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "recallState",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "The retention sweep: memories whose window has passed.",
      "collectionGroup": "memories",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "recallState",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "recallExpiresAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "_comment": "Vector search over chunks, pre-filtered to one user. The filter fields must be indexed alongside the vector or the KNN query is rejected.",
      "collectionGroup": "chunks",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "embedding",
          "vectorConfig": {
            "dimension": 1536,
            "flat": {}
          }
        }
      ]
    },
    {
      "_comment": "Same, restricted to memories that are still recallable \u2014 so an expired memory cannot answer a question.",
      "collectionGroup": "chunks",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "recallState",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "embedding",
          "vectorConfig": {
            "dimension": 1536,
            "flat": {}
          }
        }
      ]
    },
    {
      "_comment": "Citation resolution: every chunk of one memory, in order.",
      "collectionGroup": "chunks",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "memoryId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "ordinal",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "_comment": "Sign-in: the newest unconsumed challenge for an address.",
      "collectionGroup": "emailChallenges",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "email",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "consumedAt",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Backup restore discovery: this user's ready snapshots, newest first.",
      "collectionGroup": "backupSnapshots",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "state",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "collectionGroup": "storageAccounts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "provider",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "providerAccountId",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "collectionGroup": "storageAccounts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "state",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "collectionGroup": "memories",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "storageAccountId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "sourceRef",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "collectionGroup": "indexJobs",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "accountId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Sign-in rate limit: how many codes this address was sent in the last hour. Cannot use the (email, consumedAt, createdAt) index above \u2014 consumedAt sits in the middle of that prefix, so a query on email + createdAt cannot reach the range field. Without this the aggregate raises FAILED_PRECONDITION, which a callable reports as INTERNAL.",
      "collectionGroup": "emailChallenges",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "email",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "_comment": "The re-index backlog sweep: oldest un-embedded memories first, across all users. A collection-wide status query with an ordering needs its own composite index \u2014 the per-user memory indexes all lead with userId and cannot serve it.",
      "collectionGroup": "memories",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "_comment": "\u00a724's type filter as a KNN pre-filter. find_nearest accepts equality filters, and the index must list them before the vector field or the query is rejected.",
      "collectionGroup": "chunks",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "recallState",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "memoryType",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "embedding",
          "vectorConfig": {
            "dimension": 1536,
            "flat": {}
          }
        }
      ]
    },
    {
      "collectionGroup": "chunks",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "collectionGroup": "chunks",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "deleted",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}
